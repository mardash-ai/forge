          },
          "public_key": {
            "type": "string"
          },
          "secret_key": {
            "type": "string"
          },
          "skip_probe": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["public_key", "secret_key"]
      },
      "endpoint": "POST /capabilities/setup-observability"
    },
    {
      "name": "ProvisionMonitoring",
      "slug": "provision-monitoring",
      "description": "Generate the canonical metrics+logging stack (collector, Loki, promtail, Prometheus, Grafana), deploy it, wait for health, and register the MonitoringStack resource.",
      "plane": "control",
      "resource_type": "MonitoringStack",
      "events": ["MonitoringConfigured"],
      "long_running": true,
      "requires_docker": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "dir": {
            "type": "string",
            "optional": true
          },
          "project_name": {
            "type": "string",
            "default": "dorinda-grafana"
          },
          "public_host": {
            "type": "string",
            "optional": true
          },
          "ui_port": {
            "type": "number",
            "default": 3200
          },
          "network": {
            "type": "string",
            "default": "observability"
          },
          "proxy_network": {
            "type": "string",
            "default": "proxy"
          },
          "alert_email": {
            "type": "string",
            "default": "ops@forge.local"
          },
          "log_scope_regex": {
            "type": "string",
            "default": "^(traefik|otel-collector|loki|promtail|prometheus|grafana|dorinda-.*|forge-.*)$"
          },
          "langfuse_otlp_b64": {
            "type": "string",
            "optional": true
          },
          "smtp_host": {
            "type": "string",
            "optional": true
          },
          "smtp_user": {
            "type": "string",
            "optional": true
          },
          "smtp_password": {
            "type": "string",
            "optional": true
          },
          "smtp_from": {
            "type": "string",
            "optional": true
          },
          "langfuse_public_url": {
            "type": "string",
            "optional": true
          },
          "langfuse_project_id": {
            "type": "string",
            "optional": true
          },
          "app_db_network": {
            "type": "string",
            "optional": true
          },
          "app_db_host": {
            "type": "string",
            "optional": true
          },
          "app_db_port": {
            "type": "number",
            "optional": true
          },
          "app_db_database": {
            "type": "string",
            "optional": true
          },
          "app_db_user": {
            "type": "string",
            "optional": true
          },
          "app_db_app_id": {
            "type": "string",
            "optional": true
          },
          "app_db_password": {
            "type": "string",
            "optional": true
          },
          "env_file": {
            "type": "string",
            "default": ".env"
          },
          "health_url": {
            "type": "string",
            "optional": true
          },
          "context": {
            "type": "string",
            "optional": true
          },
          "skip_deploy": {
            "type": "boolean",
            "default": false
          },
          "regenerate_secrets": {
            "type": "boolean",
            "default": false
          },
          "health_timeout_ms": {
            "type": "number",
            "default": 240000
          }
        }
      },
      "endpoint": "POST /capabilities/provision-monitoring"
    },
    {
      "name": "Eval",
      "slug": "eval",
      "description": "Run an eval suite: drive a real model (Claude/GPT) as an MCP client against the app's tools, grade the trajectory (deterministic asserts + LLM-judge), and report a Langfuse dataset run.",
      "plane": "control",
      "resource_type": "EvalRun",
      "events": ["EvalRunCompleted"],
      "long_running": true,
      "requires_docker": false,
      "input_schema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string"
          },
          "suite": {},
          "mcp_url": {
            "type": "string"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["anthropic", "openai"]
                },
                "model": {
                  "type": "string"
                }
              },
              "required": ["provider", "model"]
            },
            "default": [
              {
                "provider": "anthropic",
                "model": "claude-opus-4-8"
              },
              {
                "provider": "openai",
                "model": "gpt-4o"
              }
            ]
          },
          "judge_model": {
            "type": "string",
            "default": "claude-opus-4-8"
          },
          "run_name": {
            "type": "string",
            "optional": true
          },
          "langfuse": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "optional": true
              },
              "publicKey": {
                "type": "string",
                "optional": true
              },
              "secretKey": {
                "type": "string",
                "optional": true
              }
            },
            "optional": true
          }
        },
        "required": ["app", "suite", "mcp_url"]
      },
      "endpoint": "POST /capabilities/eval"
    },
    {
      "name": "DeliveryCheck",
      "slug": "delivery-check",
      "description": "Guard every hop of the delivery pipeline (commit→tag→image→deploy→consumer-pin). Each failing check exits non-zero and names the specific artifact behind with a concrete remedy. Silence requires an explicit in-repo declaration with a reason.",
      "plane": "control",
      "resource_type": "DeliveryCheckRun",
      "events": ["DeliveryCheckCompleted", "DeliveryCheckFailed"],
      "long_running": false,
      "requires_docker": false,
      "input_schema": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["producer", "release", "consumer"]
            },
            "default": ["producer", "release", "consumer"]
          },
          "repo_name": {
            "type": "string",
            "default": "forge"
          },
          "source_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": ["src/", "tests/", "package.json", "Dockerfile"]
          },
          "image": {
            "type": "string",
            "optional": true
          },
          "image_label": {
            "type": "string",
            "optional": true
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "consumer_name": {
                  "type": "string"
                },
                "producer_name": {
                  "type": "string"
                },
                "pinned_version": {
                  "type": "string"
                },
                "latest_version": {
                  "type": "string"
                }
              },
              "required": ["consumer_name", "producer_name", "pinned_version", "latest_version"]
            },
            "default": []
          },
          "repo_root": {
            "type": "string",
            "optional": true
          }
        }
      },
      "endpoint": "POST /capabilities/delivery-check"
    }
