# forge-console — the operator pane. Two stages: build the SPA, then a slim runtime.
#
# The React/Vite toolchain lives ONLY in stage 1. The platform's own package.json stays at its
# eight runtime dependencies, and the shipped image carries no build tooling at all.
FROM node:22-bookworm-slim AS ui
WORKDIR /ui
COPY console/package.json console/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY console/ ./
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /forge
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --omit=optional || npm install --omit=dev --omit=optional
COPY tsconfig.json ./
COPY src ./src
COPY --from=ui /ui/dist ./console/dist
ENV PORT=3000 CONSOLE_UI_DIR=/forge/console/dist NODE_ENV=production
EXPOSE 3000
CMD ["./node_modules/.bin/tsx", "src/console/server.ts"]
