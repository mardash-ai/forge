# forge-console — the operator pane. Two stages: build the SPA, then a slim runtime.
#
# The React/Vite toolchain lives ONLY in stage 1. The platform's own package.json stays at its
# eight runtime dependencies, and the shipped image carries no build tooling at all.
FROM node:22-bookworm-slim AS ui
WORKDIR /ui
COPY console/package.json console/package-lock.json ./
# npm ci, not install: the SPA's dependency set is lockfile-governed like every other stage.
RUN npm ci --no-audit --no-fund
COPY console/ ./
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /forge
COPY package.json package-lock.json* ./
# ⛔ NO `|| npm install` fallback: npm ci exists to FAIL when lockfile and manifest disagree —
# that failure is the guard. A fallback resolves drift against semver ranges inside the build and
# ships transitive versions nobody reviewed, reporting success. If this line fails, fix the
# lockfile in the repo; never paper over it here.
RUN npm ci --omit=dev --omit=optional
COPY tsconfig.json ./
COPY src ./src
COPY --from=ui /ui/dist ./console/dist
# ⛔ The running build's identity, readable from INSIDE the container.
#
# This is the Dockerfile that actually builds forge-console (dorinda-forge-console's release.yml
# builds it from checked-out forge source). The ARG in ./Dockerfile does NOT apply here — putting it
# only there produced a production console reporting its commit as "dev", which is honest but not
# the answer a released build should give.
#
# `version` comes from the package.json copied above, so it needs no build arg and cannot drift.
# The commit does need one; absent, the console says `dev` rather than inventing an identity.
ARG FORGE_COMMIT=""
ENV FORGE_COMMIT=$FORGE_COMMIT

ENV PORT=3000 CONSOLE_UI_DIR=/forge/console/dist NODE_ENV=production
EXPOSE 3000
CMD ["./node_modules/.bin/tsx", "src/console/server.ts"]
